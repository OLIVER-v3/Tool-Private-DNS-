{
  "name": "jx-private-dns",
  "productName": "JX",
  "version": "1.1.0",
  "description": "JX - Private DNS changer for Windows",
  "author": "JX",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jx.privatedns",
    "productName": "JX",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*", "assets/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JX"
    }
  }
}
